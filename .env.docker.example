# Copy to .env.docker and choose a strong, unique password before starting.
POSTGRES_PASSWORD=
INTERNTRACK_PORT=8080

# Explicit opt-in for local HTTP. Keep the port in sync with INTERNTRACK_PORT.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Optional. Leave blank to run without Gemini.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
