# Relative paths resolve from the backend directory.
DATABASE_PATH=interntrack.sqlite3

# Required only for resume analysis. Keep the key in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Keep true for HTTPS. Set false only for local HTTP testing when required by your browser.
AUTH_COOKIE_SECURE=true
# Restrict this to the exact browser origin(s) in deployment. Defaults to local Vite origins when omitted.
# AUTH_ALLOWED_ORIGINS=https://interntrack.example.com
