# Leave blank for backend/interntrack.sqlite3 (or the legacy DATABASE_PATH override).
# Relative SQLite paths resolve from the backend directory.
DATABASE_URL=
# DATABASE_URL=sqlite:///interntrack.sqlite3
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/interntrack
# TEST_POSTGRES_URL is an optional shell variable for the compatibility suite. Use a disposable database.

# Required only for resume analysis. Keep the key in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Keep true for HTTPS deployments. Set false explicitly for localhost HTTP (including Safari).
# With false, the API URL and allowed frontend origins must use loopback HTTP.
AUTH_COOKIE_SECURE=true
# Restrict this to the exact browser origin(s) in deployment. Defaults to local Vite origins when omitted.
# AUTH_ALLOWED_ORIGINS=https://interntrack.example.com
